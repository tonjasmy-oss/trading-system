# 飞书配置
FEISHU_APP_ID=cli_a930d0d3a8399cc0
FEISHU_APP_SECRET=0DE5NCnfVnN17KlbZwPyef4FiBQAyjv5
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/44b3db32-2641-4081-93bf-22c5b6afeaab

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 数据库
DB_PATH=trading_system.db

# 加密货币交易所配置（ccxt / 独立适配器）
# 支持: binance, gateio, bitget, kraken, bitfinex, okx, bybit, weex
CRYPTO_EXCHANGE=gateio
CRYPTO_API_KEY=
CRYPTO_API_SECRET=

# Weex 交易账户 API Key（v3: 需 API Key + Secret + Passphrase）
WEEX_API_KEY=weex_8ab325b4e90ff9ac2de358096da8d821
WEEX_API_SECRET=8ebc1d409c62af3bdc485f1d73788c0f8fef16b4e580512d911d5f7cb23abcf7
WEEX_API_PASSPHRASE=qaz123WSX

# 监控配置
PRICE_CHECK_INTERVAL=60
PRICE_CHANGE_THRESHOLD=0.05

# AI 信号过滤配置
AI_MODEL=deepseek
AI_SIGNAL_FILTER_ENABLED=true
DEEPSEEK_API_KEY=sk-a30a5d0e8642430a96b515d266990e1b

# ============================================================
# 实盘交易配置（尚书省执行层）
# ============================================================
# 是否启用实盘（true=真实下单，false=模拟）
LIVE_TRADING_ENABLED=true
# 实盘交易所：binance / gateio / bybit / bitget / hyperliquid / weex
LIVE_EXCHANGE=weex
# 实盘 API Key（Weex 模式：LIVE_API_KEY/LIVE_API_SECRET 复用 WEEX_API_KEY/WEEX_API_SECRET）
LIVE_API_KEY=weex_8ab325b4e90ff9ac2de358096da8d821
LIVE_API_SECRET=8ebc1d409c62af3bdc485f1d73788c0f8fef16b4e580512d911d5f7cb23abcf7
# 测试网模式（不消耗真实资金，建议首次使用时开启）
LIVE_TESTNET=false

# ============================================================
# 多 Agent 并行配置（多标的策略轮询）
# ============================================================
# 格式：SYMBOL:STRATEGY:EXCHANGE，逗号分隔
# 策略：RSI / SMA / BOLLINGER / MACD / VOTE / AUTO / ATRSTOP / MULTIFACTOR
# 交易所：binance / gateio / bitget / hyperliquid / weex
MULTI_AGENT_ENABLED=false
AGENT_SYMBOLS=SUI/USDT:ATRSTOP:weex
AGENT_CHECK_INTERVAL=60
LIVE_ORDER_CAPITAL_PCT=0.05
LIVE_INITIAL_CAPITAL=271.76

# PostgreSQL 数据库（v2.1 新增）
DATABASE_URL=postgresql://quantdinger:quantdinger123@localhost:5432/quantdinger
DB_TYPE=postgresql

# ============================================================
# 通知渠道配置（v2.2 新增，借鉴 QuantDinger signal_notifier）
# ============================================================
# Telegram Bot（可选）
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
# TELEGRAM_CHAT_ID=-1001234567890

# Discord Webhook（可选）
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Email SMTP（可选）
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=alert@example.com
# EMAIL_TO=admin@example.com
# EMAIL_PASSWORD=your_app_password

# 自定义 Webhook（可选，支持 HMAC 签名）
# CUSTOM_WEBHOOK_URL=https://your-server.com/webhook
# CUSTOM_WEBHOOK_SECRET=your_shared_secret

# ============================================================
# LLM 统一调用配置（v2.2 新增，借鉴 QuantDinger llm.py）
# ============================================================
# AI 调用基础 URL（覆盖默认值）
# AI_BASE_URL=https://api.deepseek.com/v1
# AI 请求超时（秒）
# AI_REQUEST_TIMEOUT=30
# OpenAI 兼容接口（当 AI_MODEL 设为其他 provider 时）
# OPENAI_API_KEY=sk-xxx
# AI_MODEL_OVERRIDE=gpt-4o
